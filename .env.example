# ---- Browser-visible (safe to expose; set in Vercel as plain env vars) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---- Server-only (never prefix with VITE_; set as Vercel server env vars) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref
# Needed only for the one-click demo accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEMO_ACCOUNT_PASSWORD=long-random-string
# Gnani Prisma (speech-to-text) and Timbre (text-to-speech).
GNANI_API_KEY=your-gnani-api-key
# Lovable AI Gateway, used to turn transcripts into structured job details and search filters.
LOVABLE_API_KEY=your-lovable-api-key
